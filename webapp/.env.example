# Server-only settings: export in the shell before npm run server.
# Never use REACT_APP_ for secrets. This file is documentation, not auto-loaded.
# GOOGLE_ROUTES_API_KEY=<already-authorized Routes API key>
# SHOWTIMES_FILE=<absolute path to verified JSON feed>
# PORT=3001

# Approved remote preview only; default remains loopback.
# HOST=0.0.0.0
# PREVIEW_ORIGINS=http://your-tailscale-ip:3001,http://your-tailnet-hostname:3001
